.DS_Store

# Datasets are large and licensed; never commit
data/raw/**
data/processed/**
!data/raw/.gitkeep
!data/processed/.gitkeep
*.nt
*.ttl
*.rdf
*.n3
*.owl

# Generated results.
# Die grossen Per-Datensatz-Ausgaben (Histogramme, vorhergesagte Paare, teils
# > 40 MB) bleiben draussen; die zusammenfassenden Tabellen und die Figures
# werden versioniert, damit die Ergebnisse ohne Neulauf nachvollziehbar sind.
results/reports*/**
!results/reports*/
!results/reports*/*.csv
!results/reports*/*.json
!results/figures*/
!results/figures*/*.png
!results/figures/.gitkeep
!results/reports/.gitkeep

# PARIS-Jar: 3,5 MB, reproduzierbar via scripts/download_data.py
tools/

# Logs and caches
*.log
.cache/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Spark / Hadoop
spark-warehouse/
metastore_db/
derby.log

# Secrets
.env
*.pem
credentials.json
